# Ignora arquivos de cache do Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Ignora ambientes virtuais
venv/
env/
.venv/
.venv-build/
build/
dist/
release/
Mallard.spec
*.spec
build-windows.ps1
requirements-build.txt
installer/

# Auxiliares/artefatos do instalador (mantidos só no checkout de build)
Mallard-Setup-*.exe

# Segredos locais
.env
.env.*
!.env.example
.streamlit/secrets.toml

# Arquivo mock de frontmallard não é usado pelo aplicativo
ui/js/mockData.js

# Saves locais do Mallard (preferências, peças informadas e histórico de análises)
config.json
historico*.json
history*.json
analysis-history*.json
journal.json

# Credenciais protegidas e dados de usuário nunca devem entrar no repositório
gemini-key.dpapi
*.dpapi

# Temporários e cópias locais
*.tmp
*.bak
*.log
